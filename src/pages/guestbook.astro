---
import Layout from "../layouts/Layout.astro";
import BackLink from "../components/BackLink.astro";
import GuestbookCard from "../components/guestbook/GuestbookCard.astro";
import GuestbookForm from "../components/guestbook/GuestbookForm.astro";
import GuestbookPagination from "../components/guestbook/GuestbookPagination.astro";
import {
  getGuestbookStore,
  positiveInteger,
  GuestbookError,
  type StoredEntry,
} from "../lib/server/guestbook-store";
import { visitor } from "../lib/server/guestbook-http";
export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");
let entries: StoredEntry[] = [],
  total = 0,
  page = 1,
  totalPages = 1,
  error = "";
try {
  page = positiveInteger(Astro.url.searchParams.get("page") ?? "1");
  ({ entries, total, page, totalPages } = await getGuestbookStore().list(page));
  visitor(Astro);
} catch (reason) {
  Astro.response.status =
    reason instanceof GuestbookError ? reason.status : 503;
  error =
    reason instanceof GuestbookError
      ? reason.message
      : "留言服务暂时不可用，请稍后再来。";
}
---

<Layout title="留言板" description="打个招呼，分享想法，留下一点来过的痕迹。">
  <div class="flex flex-col items-center px-4 pt-8 pb-24">
    <div class="w-full max-w-3xl mb-16">
      <BackLink href="/" label="返回首页" />
    </div>
    <header class="w-full max-w-xl mb-12 text-center">
      <h1 class="text-white text-3xl font-bold tracking-tight mb-3">
        留言板
      </h1><p class="text-darkslate-300 text-sm leading-relaxed">
        打个招呼，或分享你的想法。每一条留言我都会认真读。
      </p>
    </header>
    {
      error ? (
        <p role="alert" class="text-red-400 text-sm mb-8">
          {error}
        </p>
      ) : (
        <GuestbookForm class="w-full max-w-xl mb-12" />
      )
    }
    <section class="w-full max-w-3xl" aria-label="访客留言">
      <h2 id="entries-count" class="text-white text-sm font-semibold mb-4">
        {total} 条留言
      </h2>
      <div id="entries" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          entries.length
            ? entries.map((entry) => <GuestbookCard entry={entry} />)
            : !error && (
                <p
                  data-empty-state
                  class="sm:col-span-2 text-center py-20 text-darkslate-300 text-sm"
                >
                  还没有留言，欢迎留下第一条。
                </p>
              )
        }
      </div>
      <GuestbookPagination currentPage={page} totalPages={totalPages} />
    </section>
  </div>
</Layout>
