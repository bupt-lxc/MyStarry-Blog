---
import Layout from "../layouts/Layout.astro";
import BackLink from "../components/BackLink.astro";

export const prerender = true;
---

<Layout title="Guestbook · Preview" description="Guestbook status for this portfolio preview.">
  <main class="text-white w-full max-w-3xl px-6 py-12 min-h-screen">
    <BackLink href="/" label="Back to home" />
    <section class="mt-16 max-w-xl">
      <h1 class="text-3xl font-bold">Guestbook</h1>
      <p class="text-darkslate-200 leading-relaxed">
        留言板暂未开启。当前版本提供个人网站模板预览，博客和作品展示可正常访问。
      </p>
      <a class="text-primary-400 underline" href="/blog">Browse the blog →</a>
    </section>
  </main>
</Layout>
