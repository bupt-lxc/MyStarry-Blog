---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card/index.astro";
import IntroCard from "../components/IntroCard.astro";
import ThemeChangeCard from "../components/ThemeChangeCard.astro";
import TimeZone from "../components/TimeZoneCard.astro";
import Globe from "../components/Globe";
import DesignWorksCard from "../components/DesignWorksCard.astro";
import SkillsCard from "../components/SkillsCard.astro";
export const prerender = true;
---

<script>
  import { initHomeEntrance } from "../lib/home-entrance";
  import { initCardGrids } from "../lib/card-grids";
  initHomeEntrance();
  initCardGrids();
</script>
<Layout
  title="李星辰 · AI 与软件开发"
  description="李星辰的个人主页。北京邮电大学软件工程硕士，关注 AI Agent、RAG、大模型安全与软件开发，分享项目实践与学习记录。"
>
  <main class="home-bento" aria-label="李星辰的个人主页">
    <IntroCard />
    <SkillsCard />
    <DesignWorksCard />
    <Card
      href="/projects/"
      colSpan=""
      class="portfolio-card"
      padding="p-6"
      arrowCorner
    >
      <div
        slot="background"
        class="absolute inset-0 overflow-hidden pointer-events-none"
        aria-hidden="true"
      >
        <div id="playground-grid" class="absolute inset-0"></div>
      </div>
      <div class="portfolio-label">
        <p class="eyebrow">把想法做成作品</p><h2>作品集</h2><p>
          项目实践与技术探索
        </p>
      </div>
    </Card>
    <TimeZone />
    <div class="appearance-card"><ThemeChangeCard /></div>
    <Card href="/blog/" colSpan="" class="blog-card" padding="p-6">
      <div
        slot="background"
        id="blog-bg"
        class="absolute inset-0 overflow-hidden pointer-events-none"
        aria-hidden="true"
      >
      </div>
      <p class="eyebrow">学习与思考</p><h2 class="section-title">博客</h2>
    </Card>
    <Card
      href="/guestbook/"
      colSpan=""
      class="guestbook-card"
      padding="p-6"
      prefetch="viewport"
    >
      <div
        slot="background"
        id="guestbook-grid"
        class="absolute inset-0 overflow-hidden pointer-events-none"
        aria-hidden="true"
      >
      </div>
      <p class="eyebrow">很高兴认识你</p><h2 class="section-title">留言板</h2>
    </Card>
    <Card href="/travel/" colSpan="" class="travel-card" padding="p-6">
      <div class="travel-tile">
        <div>
          <p class="eyebrow">在路上，换个视角</p><h2 class="section-title">
            旅行足迹
          </h2>
        </div><div class="travel-mini" aria-hidden="true">
          <Globe client:visible scale={38} />
        </div>
      </div>
    </Card>
  </main>
</Layout>
