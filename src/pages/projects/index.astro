---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BackLink from "../../components/BackLink.astro";
import CapabilityOverview from "../../components/projects/CapabilityOverview.astro";
import CapabilitySection from "../../components/projects/CapabilitySection.astro";
import { getProjectSections, validateProjects } from "../../lib/projects";
import { SITE } from "../../site-config";
export const prerender = true;
const projects = await getCollection("projects");
validateProjects(projects.map((project) => project.data));
const sections = getProjectSections(projects);
const projectCount = new Set(projects.map((project) => project.data.slug)).size;
---

<Layout
  title={`项目作品集｜${SITE.author.fullName}`}
  description="从业务系统交付，到智能体应用，再到模型训练与推理优化。李星辰的项目作品集。"
>
  <main class="projects-page">
    <BackLink href="/" label="← 返回首页" />
    <header>
      <p class="eyebrow">项目实践</p><h1>项目作品集</h1><p class="intro">
        从业务系统交付，到智能体应用，再到模型训练与推理优化。
      </p><p class="count">
        {sections.length} 个能力方向 · {projectCount} 个项目
      </p>
    </header>
    <CapabilityOverview />
    {sections.map((section) => <CapabilitySection section={section} />)}
    <footer><a href="/">返回首页 ↗</a><a href="/blog/">阅读博客 ↗</a></footer>
  </main>
</Layout>
<style>
  .projects-page {
    width: min(1200px, 100%);
    margin: auto;
    padding: 3rem 2rem 5rem;
    color: var(--darkslate-100);
  }
  header {
    margin: 3rem 0 2.5rem;
  }
  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--primary-500);
  }
  h1 {
    font-size: clamp(2rem, 4.5vw, 3.6rem);
    font-weight: 700;
    line-height: 1.3;
    margin: 1rem 0 1.25rem;
  }
  .intro {
    max-width: 44rem;
    color: var(--darkslate-200);
    font-size: 1rem;
    line-height: 1.9;
  }
  .count {
    margin-top: 1.8rem;
    color: var(--darkslate-300);
    font-size: 0.8rem;
  }
  footer {
    display: flex;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--darkslate-400);
    color: var(--primary-500);
    font-size: 0.85rem;
  }
  @media (max-width: 759px) {
    .projects-page {
      padding: 2rem 1.2rem 4rem;
    }
    header {
      margin-top: 2.5rem;
    }
  }
  footer a:focus-visible {
    outline: 2px solid var(--primary-500);
    outline-offset: 4px;
  }
</style>
