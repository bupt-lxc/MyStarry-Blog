---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BackLink from "../../components/BackLink.astro";
import ProjectCard from "../../components/projects/ProjectCard.astro";
import { sortProjects, validateProjects } from "../../lib/projects";
import { SITE } from "../../site-config";
export const prerender = true;
const projects = sortProjects(await getCollection("projects"));
validateProjects(projects.map((project) => project.data));
---

<Layout
  title={`项目作品集｜${SITE.author.fullName}`}
  description="李星辰的项目实践：智能体与大模型应用、异构算力评测、全栈交付与算法工程。"
>
  <main class="projects-page">
    <BackLink href="/" label="← 返回首页" />
    <header>
      <p class="eyebrow">项目实践</p><h1>
        让技术走进真实场景<span>。</span>
      </h1><p class="intro">
        从智能体、检索增强到全栈交付，记录我在真实业务约束下解决问题的过程。
      </p><p class="count">
        {String(projects.length).padStart(2, "0")} 个项目 · 背景 / 职责 / 成果
      </p>
    </header>
    <div class="project-list">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    <footer><a href="/">返回首页 ↗</a><a href="/blog/">阅读博客 ↗</a></footer>
  </main>
</Layout>
<style>
  .projects-page {
    width: min(1200px, 100%);
    margin: auto;
    padding: 3rem 2rem 5rem;
    color: var(--darkslate-100);
  }
  header {
    margin: 3rem 0 2.5rem;
  }
  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--primary-500);
  }
  h1 {
    font-size: clamp(2rem, 4.5vw, 3.6rem);
    font-weight: 700;
    line-height: 1.3;
    margin: 1rem 0 1.25rem;
  }
  h1 span {
    color: var(--primary-500);
  }
  .intro {
    max-width: 44rem;
    color: var(--darkslate-200);
    font-size: 1rem;
    line-height: 1.9;
  }
  .count {
    margin-top: 1.8rem;
    color: var(--darkslate-300);
    font-size: 0.8rem;
  }
  .project-list {
    display: grid;
    gap: 1.6rem;
  }
  footer {
    display: flex;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--darkslate-400);
    color: var(--primary-500);
    font-size: 0.85rem;
  }
  @media (max-width: 759px) {
    .projects-page {
      padding: 2rem 1.2rem 4rem;
    }
    header {
      margin-top: 2.5rem;
    }
    .project-list {
      gap: 1.2rem;
    }
  }
</style>
