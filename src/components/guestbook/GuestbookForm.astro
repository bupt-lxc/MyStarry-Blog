---
import { Icon } from "astro-icon/components";
interface Props {
  class?: string;
  parentId?: number;
  replyName?: string;
}
const { class: className, parentId, replyName } = Astro.props;
const inputClasses =
  "w-full px-3 py-2 bg-darkslate-700 border border-darkslate-500 rounded-lg text-white text-sm placeholder:text-darkslate-400 focus:outline-none focus:border-primary-500/60 transition-colors";
---

<details
  class:list={[
    "group rounded-xl border border-darkslate-500 bg-darkslate-600/40 overflow-hidden",
    className,
  ]}
>
  <summary
    class="flex items-center justify-between px-5 py-4 text-white hover:bg-darkslate-500/30 transition-colors cursor-pointer list-none"
  >
    <span class="text-sm font-medium"
      >{parentId ? `回复 ${replyName}` : "写一条留言"}</span
    >
    <Icon
      name="pixel-plus"
      class="w-4 h-4 text-darkslate-300 transition-transform duration-200 group-open:rotate-45"
    />
  </summary>
  <form
    data-guestbook-form
    data-parent-id={parentId}
    class="p-5 flex flex-col gap-3 border-t border-darkslate-500"
  >
    <div class="flex gap-3 flex-wrap">
      <label class="flex-1 min-w-0"
        ><span class="block text-xs text-darkslate-300 mb-1.5">昵称 *</span
        ><input
          type="text"
          name="name"
          required
          maxlength="32"
          autocomplete="nickname"
          class={inputClasses}
          placeholder="怎么称呼你"
        /></label
      >
      <label class="flex-1 min-w-0"
        ><span class="block text-xs text-darkslate-300 mb-1.5"
          >网站（选填）</span
        ><input
          type="url"
          name="website"
          maxlength="200"
          autocomplete="url"
          class={inputClasses}
          placeholder="https://..."
        /></label
      >
    </div>
    <label
      ><span class="block text-xs text-darkslate-300 mb-1.5">留言 *</span
      ><textarea
        name="message"
        required
        maxlength="1000"
        rows="3"
        class:list={[inputClasses, "resize-y"]}
        placeholder="打个招呼，或分享你的想法……"></textarea></label
    >
    <p data-form-error role="alert" class="text-red-400 text-xs hidden"></p>
    <button
      type="submit"
      class="self-end px-5 py-2 bg-primary-500 hover:bg-primary-600 text-white text-sm font-medium rounded-lg transition-colors disabled:opacity-50"
      >发送</button
    >
    <noscript
      ><p class="text-darkslate-200 text-xs">
        发送留言需要启用 JavaScript。
      </p></noscript
    >
  </form>
</details>
<script>
  function attachForms() {
    document
      .querySelectorAll<HTMLFormElement>("[data-guestbook-form]")
      .forEach((form) => {
        if (form.dataset.handlerAttached) return;
        form.dataset.handlerAttached = "1";
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const error = form.querySelector<HTMLElement>("[data-form-error]")!;
          const button = form.querySelector<HTMLButtonElement>(
            "button[type=submit]",
          )!;
          const values = new FormData(form);
          const payload = {
            name: String(values.get("name") ?? "").trim(),
            message: String(values.get("message") ?? "").trim(),
            website: String(values.get("website") ?? "").trim(),
            ...(form.dataset.parentId
              ? { parentId: Number(form.dataset.parentId) }
              : {}),
          };
          error.classList.add("hidden");
          button.disabled = true;
          button.textContent = "正在发送……";
          try {
            const response = await fetch("/api/guestbook", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            const data = await response.json();
            if (!response.ok)
              throw new Error(data.error ?? "发送失败，请稍后再试。");
            // Render again from SQLite so replies, totals and pagination stay aligned.
            if (form.dataset.parentId) window.location.reload();
            else window.location.assign("/guestbook");
          } catch (reason) {
            error.textContent =
              reason instanceof Error
                ? reason.message
                : "网络暂时不可用，请稍后再试。";
            error.classList.remove("hidden");
          } finally {
            button.disabled = false;
            button.textContent = "发送";
          }
        });
      });
  }
  attachForms();
  document.addEventListener("astro:page-load", attachForms);
</script>
