---
import { Icon } from "astro-icon/components";

interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;
const hasPreviousPage = currentPage > 1;
const hasNextPage = currentPage < totalPages;

const linkClasses =
  "inline-flex items-center gap-1.5 px-3 py-1.5 text-darkslate-200 bg-darkslate-600 hover:bg-darkslate-500 rounded-lg transition-colors";
---

{
  totalPages > 1 && (
    <nav
      aria-label="留言分页"
      class="flex items-center justify-between mt-8 pt-4 border-t border-darkslate-500/50 text-xs"
    >
      {hasPreviousPage ? (
        <a
          href={`?page=${currentPage - 1}`}
          aria-label="上一页"
          data-skip-loader
          class={linkClasses}
        >
          <Icon name="pixel-arrow-up-right" class="w-3 h-3 -rotate-135" />
          上一页
        </a>
      ) : (
        <span />
      )}
      <span class="text-darkslate-300">
        {currentPage} / {totalPages}
      </span>
      {hasNextPage ? (
        <a
          href={`?page=${currentPage + 1}`}
          aria-label="下一页"
          data-skip-loader
          class={linkClasses}
        >
          下一页
          <Icon name="pixel-arrow-up-right" class="w-3 h-3 rotate-45" />
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
