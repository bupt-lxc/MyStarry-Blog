---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { data } = project;
const href = `/projects/${data.slug}/`;
---

<article class="project-card card">
  <a href={href} class="project-cover" aria-label={`查看${data.title}详情`}>
    {
      data.cover ? (
        <Image
          src={data.cover}
          alt={data.coverAlt || data.title}
          widths={[480, 800]}
          sizes="(min-width: 760px) 38vw, 100vw"
          loading="lazy"
        />
      ) : (
        <div class="text-cover">
          <>
            <span>项目 / {String(data.order).padStart(2, "0")}</span>
            <strong>{data.title.split("｜")[0]}</strong>
            <span>{data.tags.slice(0, 3).join(" · ")}</span>
          </>
        </div>
      )
    }
  </a>
  <div class="project-copy">
    <p class="context">{data.context}<span>{data.period}</span></p>
    <h2><a href={href}>{data.title}</a></h2>
    <p class="summary">{data.summary}</p>
    <p class="role"><span>我的职责</span>{data.role}</p>
    <ul class="outcomes" aria-label="项目成果">
      {data.outcomes.map((outcome) => <li>{outcome}</li>)}
    </ul>
    <ul class="tags" aria-label="技术栈">
      {data.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <div class="links">
      <a class="detail" href={href}>查看项目详情 ↗</a>{
        data.links.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            {link.label}
            <span class="sr-only">（新窗口）</span> ↗
          </a>
        ))
      }
    </div>
  </div>
</article>
<style>
  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    overflow: hidden;
    border: 1px solid var(--darkslate-400);
    border-radius: 1.25rem;
    background: var(--darkslate-600);
    transition: border-color 0.2s;
  }
  .project-card:hover {
    border-color: var(--primary-500);
  }
  .project-cover {
    display: flex;
    min-height: 22rem;
    align-items: center;
    justify-content: center;
    background: var(--darkslate-800);
    overflow: hidden;
    padding: 1.25rem;
    border-right: 1px solid var(--darkslate-400);
  }
  .project-cover img {
    width: 100%;
    height: 100%;
    max-height: 28rem;
    object-fit: contain;
    border-radius: 0.5rem;
    transition: transform 0.25s;
  }
  .project-cover:hover img {
    transform: scale(1.025);
  }
  .text-cover {
    width: 100%;
    min-height: 18rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
    color: var(--primary-500);
    gap: 2rem;
  }
  .text-cover strong {
    font-size: clamp(1.8rem, 3vw, 3rem);
    line-height: 1.25;
  }
  .text-cover span {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }
  .project-copy {
    padding: 2rem;
    min-width: 0;
  }
  .context {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.8rem;
    color: var(--darkslate-300);
    line-height: 1.8;
  }
  .context span {
    white-space: nowrap;
  }
  h2 {
    font-size: 1.35rem;
    line-height: 1.5;
    margin: 0.7rem 0 1rem;
    color: var(--darkslate-50);
    font-weight: 700;
  }
  h2 a:hover {
    color: var(--primary-500);
  }
  .summary,
  .role {
    font-size: 0.9rem;
    line-height: 1.9;
    color: var(--darkslate-200);
  }
  .role {
    margin-top: 1rem;
  }
  .role span {
    display: block;
    color: var(--darkslate-300);
    font-size: 0.75rem;
  }
  .outcomes {
    margin: 1rem 0;
    display: grid;
    gap: 0.45rem;
    color: var(--primary-400);
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .outcomes li::before {
    content: "↗";
    margin-right: 0.5rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tags li {
    font-size: 0.7rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--darkslate-400);
    border-radius: 1rem;
    color: var(--darkslate-200);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    margin-top: 1.4rem;
    align-items: center;
    font-size: 0.8rem;
    color: var(--darkslate-200);
  }
  .links a:hover {
    color: var(--primary-500);
  }
  .links .detail {
    color: var(--primary-500);
    font-weight: 600;
    margin-right: auto;
  }
  a:focus-visible {
    outline: 2px solid var(--primary-500);
    outline-offset: 5px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 759px) {
    .project-card {
      grid-template-columns: 1fr;
    }
    .project-cover {
      min-height: 0;
      height: 15rem;
      border-right: 0;
      border-bottom: 1px solid var(--darkslate-400);
    }
    .project-cover img {
      max-height: 100%;
    }
    .project-copy {
      padding: 1.35rem;
    }
    .text-cover {
      min-height: 0;
      height: 100%;
      padding: 0.5rem;
      gap: 0.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-cover img {
      transition: none;
    }
    .project-cover:hover img {
      transform: none;
    }
  }
</style>
