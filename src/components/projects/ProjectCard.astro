---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { CAPABILITIES } from "../../lib/project-capabilities";
import { getCardOutcomes } from "../../lib/projects";
import ProjectOutcome from "./ProjectOutcome.astro";
interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { data } = project;
const href = `/projects/${data.slug}/`;
const outcomes = getCardOutcomes(data);
const source =
  data.card.sourceLinkIndex === undefined
    ? undefined
    : data.links[data.card.sourceLinkIndex];
---

<article class="project-card card" data-project-slug={data.slug}>
  <a href={href} class="project-cover" aria-label={`查看${data.title}详情`}>
    {
      data.cover ? (
        <Image
          src={data.cover}
          alt={data.coverAlt || data.title}
          widths={[480, 800]}
          sizes="(min-width: 1200px) 350px, (min-width: 760px) 30vw, 90vw"
          loading="lazy"
        />
      ) : (
        <div class="text-cover">
          <>
            <span>项目 / {String(data.order).padStart(2, "0")}</span>
            <strong>{data.title.split("｜")[0]}</strong>
            <span>{data.card.tags.join(" · ")}</span>
          </>
        </div>
      )
    }
  </a>
  <div class="project-copy">
    <p class="context">{data.context}<span>{data.period}</span></p>
    <h3><a href={href}>{data.title}</a></h3>
    <p class="summary">{data.summary}</p>
    <div class="contributions">
      <p>我的贡献</p>
      <ul>
        {
          data.card.contributions.map((contribution) => (
            <li data-project-contribution>{contribution}</li>
          ))
        }
      </ul>
    </div>
    <ul class="outcomes" aria-label="项目成果">
      <li data-outcome-kind="primary">
        <ProjectOutcome outcome={outcomes.primary} prominent />
      </li>
      {
        outcomes.secondary && (
          <li data-outcome-kind="secondary">
            <ProjectOutcome outcome={outcomes.secondary} />
          </li>
        )
      }
    </ul>
    <ul class="tags" aria-label="技术栈">
      {data.card.tags.map((tag) => <li data-project-tag>{tag}</li>)}
    </ul>
    {
      data.secondaryEvidence.length > 0 && (
        <div class="secondary-capabilities">
          {data.secondaryEvidence.map((evidence) => (
            <a href={`${href}#${evidence.anchor}`}>
              同时覆盖：
              {
                CAPABILITIES.find(
                  (capability) => capability.id === evidence.capability,
                )?.name
              }{" "}
              ↗
            </a>
          ))}
        </div>
      )
    }
    <div class="links">
      <a class="detail" href={href}>查看项目详情 ↗</a>{
        source && (
          <a href={source.url} target="_blank" rel="noopener noreferrer">
            {source.label}
            <span class="sr-only">（新窗口）</span> ↗
          </a>
        )
      }
    </div>
  </div>
</article>
<style>
  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    border: 1px solid var(--darkslate-400);
    border-radius: 1.25rem;
    background: var(--darkslate-600);
    transition: border-color 0.2s;
  }
  .project-card:hover {
    border-color: var(--primary-500);
  }
  .project-cover {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--darkslate-800) 60%, transparent);
    padding: 1rem;
    border-radius: inherit;
    border-right: 1px solid var(--darkslate-400);
  }
  .project-cover img {
    width: 100%;
    height: auto;
    max-height: 20rem;
    object-fit: contain;
    border-radius: 0.5rem;
    transition: transform 0.25s;
  }
  .project-cover:hover img {
    transform: scale(1.025);
  }
  .text-cover {
    width: 100%;
    min-height: 12rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
    color: var(--primary-500);
    gap: 1.5rem;
  }
  .text-cover strong {
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .text-cover span {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }
  .project-copy {
    padding: 1.5rem 1.75rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .context {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.8rem;
    color: var(--darkslate-300);
    line-height: 1.8;
  }
  .context span {
    white-space: normal;
    overflow-wrap: anywhere;
    max-width: 100%;
  }
  h3 {
    font-size: 1.25rem;
    line-height: 1.5;
    margin: 0.55rem 0 0.7rem;
    color: var(--darkslate-50);
    font-weight: 700;
  }
  h3 a:hover {
    color: var(--primary-500);
  }
  .summary {
    font-size: 0.86rem;
    line-height: 1.8;
    color: var(--darkslate-200);
  }
  .contributions {
    margin-top: 0.85rem;
  }
  .contributions p {
    color: var(--darkslate-300);
    font-size: 0.75rem;
  }
  .contributions ul {
    padding-left: 1.1rem;
    list-style: disc;
    margin-top: 0.25rem;
    display: grid;
    gap: 0.2rem;
    color: var(--darkslate-200);
    font-size: 0.84rem;
    line-height: 1.7;
  }
  .outcomes {
    margin: 0.95rem 0;
    display: grid;
    gap: 0.3rem;
  }
  .secondary-capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--darkslate-300);
    font-size: 0.75rem;
    line-height: 1.8;
    margin-top: 0.65rem;
  }
  .secondary-capabilities a:hover {
    color: var(--primary-500);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tags li {
    font-size: 0.7rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--darkslate-400);
    border-radius: 1rem;
    color: var(--darkslate-200);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    margin-top: 1rem;
    align-items: center;
    font-size: 0.8rem;
    color: var(--darkslate-200);
  }
  .links a:hover {
    color: var(--primary-500);
  }
  .links .detail {
    color: var(--primary-500);
    font-weight: 600;
    margin-right: auto;
  }
  a:focus-visible {
    outline: 2px solid var(--primary-500);
    outline-offset: 5px;
  }
  .project-cover:focus-visible {
    outline-offset: -5px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 759px) {
    .project-card {
      grid-template-columns: minmax(0, 1fr);
    }
    .project-cover {
      min-height: 0;
      height: 13rem;
      border-right: 0;
      border-bottom: 1px solid var(--darkslate-400);
    }
    .project-cover img {
      max-height: 100%;
    }
    .project-copy {
      padding: 1.35rem;
    }
    .text-cover {
      min-height: 0;
      height: 100%;
      padding: 0.5rem;
      gap: 0.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-cover img {
      transition: none !important;
    }
    .project-cover:hover img {
      transform: none;
    }
  }
</style>
