---
import Card from "./Card/index.astro";
import { SITE } from "../site-config";
---

<Card colSpan="" class="profile-card" padding="p-6 md:p-8">
  <div class="profile-heading">
    <div>
      <p class="eyebrow">你好，欢迎来到我的个人主页</p>
      <h1>
        我是<span class="accent">李星辰</span><span class="name-dot">.</span>
      </h1>
      <p class="profile-focus">AI Agent · RAG · 大模型安全 · 软件开发</p>
    </div>
    <div class="profile-avatar" aria-label="李星辰的头像">
      <span aria-hidden="true">星辰</span>
      <img
        src="/profile-avatar.png"
        width="112"
        height="112"
        alt="李星辰的 GitHub 头像"
        fetchpriority="high"
      />
    </div>
  </div>
  <p class="profile-intro">
    北京邮电大学 · 软件工程硕士<br /><span class="muted"
      >2024.09—2027.06（预计） · 中国北京</span
    >
  </p>
  <p class="profile-summary">
    关注智能体的真实落地，探索从检索、工具调用到安全对齐的完整链路。也喜欢把复杂业务做成好用的软件。
  </p>
  <div class="profile-links" aria-label="社交与联系方式">
    <a href={SITE.links.github} target="_blank" rel="noopener noreferrer"
      >GitHub ↗</a
    >
    <a href={SITE.links.bilibili} target="_blank" rel="noopener noreferrer"
      >B站 ↗</a
    >
    <a href={`mailto:${SITE.links.email}`}>邮件联系 ↗</a>
  </div>
  <div class="contact-details">
    <span
      ><a href={`mailto:${SITE.links.email}`}>{SITE.links.email}</a><button
        data-copy={SITE.links.email}
        aria-label="复制邮箱">复制</button
      ></span
    >
    <span
      ><a href="tel:+8618915790233">{SITE.links.phone}</a><button
        data-copy={SITE.links.phone}
        aria-label="复制电话号码">复制</button
      ></span
    >
  </div>
  <span id="copy-feedback" class="sr-only" role="status" aria-live="polite"
  ></span>
</Card>
<script>
  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLButtonElement>("[data-copy]")
      .forEach((button) => {
        button.addEventListener("click", async () => {
          const feedback = document.getElementById("copy-feedback");
          try {
            const value = button.dataset.copy ?? "";
            let copied = false;
            try {
              if (navigator.clipboard?.writeText) {
                await navigator.clipboard.writeText(value);
                copied = true;
              }
            } catch {
              /* HTTP deployments can use the selection fallback below. */
            }
            if (!copied) {
              const previousFocus =
                document.activeElement as HTMLElement | null;
              const field = document.createElement("textarea");
              field.value = value;
              field.setAttribute("readonly", "");
              field.setAttribute("aria-hidden", "true");
              field.style.cssText = "position:fixed;left:-9999px;top:0";
              document.body.appendChild(field);
              try {
                field.select();
                field.setSelectionRange(0, value.length);
                copied = document.execCommand("copy");
              } finally {
                field.remove();
                previousFocus?.focus({ preventScroll: true });
              }
            }
            if (!copied) throw new Error("copy failed");
            button.textContent = "已复制";
            if (feedback) feedback.textContent = "已复制到剪贴板";
            setTimeout(() => {
              if (button.isConnected) button.textContent = "复制";
            }, 1800);
          } catch {
            if (feedback) feedback.textContent = "复制失败，请选中文字手动复制";
            button.textContent = "请手动复制";
          }
        });
      });
    const avatar = document.querySelector<HTMLImageElement>(
      ".profile-avatar img",
    );
    if (avatar?.complete && avatar.naturalWidth === 0) avatar.hidden = true;
    avatar?.addEventListener("error", () => {
      avatar.hidden = true;
    });
  });
</script>
