---
interface Props {
  href?: string;
  class?: string;
  label?: string;
}

const {
  href = "/projects/",
  class: extraClass = "",
  label = "返回",
} = Astro.props;
---

<span class:list={["btn-shell btn-shell--flat inline-flex w-fit", extraClass]}>
  <a
    href={href}
    class="btn--ns btn-chrome inline-flex items-center w-fit px-4 py-2 rounded-lg"
  >
    {label}
  </a>
</span>
