---
import Card from "./Card/index.astro";
---

<Card colSpan="" class="clock-card" padding="p-6">
  <div class="clock-heading">
    <p class="eyebrow">北京时间</p><button
      id="clock-format"
      aria-label="切换为十二小时制">12小时</button
    >
  </div>
  <time
    id="beijing-clock"
    class="beijing-clock"
    datetime={new Date().toISOString()}
    >{
      new Intl.DateTimeFormat("zh-CN", {
        timeZone: "Asia/Shanghai",
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23",
      }).format(new Date())
    }</time
  >
  <p class="clock-caption">中国 · 北京 <span class="accent">UTC+8</span></p>
  <p id="beijing-date" class="clock-date muted">
    {
      new Intl.DateTimeFormat("zh-CN", {
        timeZone: "Asia/Shanghai",
        year: "numeric",
        month: "long",
        day: "numeric",
        weekday: "short",
      }).format(new Date())
    }
  </p>
  <p id="visitor-clock" class="muted clock-visitor"></p>
</Card>
<script>
  let clockInterval: ReturnType<typeof setInterval> | undefined;
  document.addEventListener("astro:page-load", () => {
    const clock = document.getElementById("beijing-clock");
    const toggle = document.getElementById("clock-format");
    const visitor = document.getElementById("visitor-clock");
    const date = document.getElementById("beijing-date");
    if (!clock) return;
    let hour12 = false;
    const update = () => {
      const now = new Date();
      clock.textContent = new Intl.DateTimeFormat("zh-CN", {
        timeZone: "Asia/Shanghai",
        hour: "2-digit",
        minute: "2-digit",
        hour12,
      }).format(now);
      clock.setAttribute("datetime", now.toISOString());
      if (date)
        date.textContent = new Intl.DateTimeFormat("zh-CN", {
          timeZone: "Asia/Shanghai",
          year: "numeric",
          month: "long",
          day: "numeric",
          weekday: "short",
        }).format(now);
      if (visitor)
        visitor.textContent = `你的时间 ${new Intl.DateTimeFormat("zh-CN", { hour: "2-digit", minute: "2-digit", hour12 }).format(now)}`;
      if (toggle) {
        toggle.textContent = hour12 ? "24小时" : "12小时";
        toggle.setAttribute(
          "aria-label",
          hour12 ? "切换为二十四小时制" : "切换为十二小时制",
        );
      }
    };
    toggle?.addEventListener("click", () => {
      hour12 = !hour12;
      update();
    });
    update();
    clearInterval(clockInterval);
    clockInterval = setInterval(update, 1000);
  });
  document.addEventListener("astro:before-swap", () =>
    clearInterval(clockInterval),
  );
</script>
