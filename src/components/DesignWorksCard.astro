---
import Card from "./Card/index.astro";
const internships = [
  {
    company: "中国电信北京分公司",
    team: "数智北分 / 创新研发中心",
    role: "大模型算法实习生",
    date: "2026.07—2026.10",
    summary: "智能体数据采集、算力选型推荐与大模型训练推理评测。",
  },
  {
    company: "奥迪（中国）",
    team: "C/EV-L 测试车辆研发部门",
    role: "软件开发",
    date: "2026.04—2026.07",
    summary: "多智能体车辆诊断、混合 RAG 与采购预算协作系统开发。",
  },
  {
    company: "中国移动九天 AI 研究院",
    team: "基础研究中心",
    role: "大模型安全可信实习生",
    date: "2026.01—2026.04",
    summary: "Agentic RL、风险感知采样与 GRPO 安全对齐。",
  },
];
---

<Card colSpan="" class="experience-card" padding="p-6">
  <p class="eyebrow">从研究到业务现场</p>
  <h2 class="section-title">实习经历<span class="accent"> / 03</span></h2>
  <ol class="internship-list">
    {
      internships.map((item) => (
        <li>
          <div class="internship-heading">
            <>
              <h3>{item.company}</h3>
              <time>{item.date}</time>
            </>
          </div>
          <p class="internship-team">{item.team}</p>
          <p class="internship-role">{item.role}</p>
          <p class="internship-summary">{item.summary}</p>
        </li>
      ))
    }
  </ol>
</Card>
