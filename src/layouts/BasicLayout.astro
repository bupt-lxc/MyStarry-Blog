---
import "../style.css";
import { ClientRouter } from "astro:transitions";
import { Icon } from "astro-icon/components";
import { Font } from "astro:assets";
import { SITE } from "../site-config";
import GridTransition from "../components/GridTransition.astro";
import StylePanel from "../components/StylePanel.astro";
import BackToTop from "../components/BackToTop.astro";
import { BUTTON_FRAME, cssVars } from "../lib/nine-slice";
import { appearanceBootstrap } from "../lib/appearance";
interface Props {
  title: string;
  description: string;
  page?: "travel" | "blog";
  pubDate?: string;
  hideSoundToggle?: boolean;
  hideCompanion?: boolean;
}
const { title, description, page, pubDate, hideSoundToggle } = Astro.props;
const image = `${Astro.url.origin}/og-image.svg`;
const person = {
  "@type": "Person",
  name: SITE.author.fullName,
  url: Astro.url.origin,
  sameAs: [SITE.links.github, SITE.links.bilibili],
  image: `${Astro.url.origin}/profile-avatar.png`,
  jobTitle: SITE.author.jobTitle,
  knowsAbout: ["AI Agent", "RAG", "大模型安全", "软件开发"],
  affiliation: { "@type": "CollegeOrUniversity", name: "北京邮电大学" },
  address: {
    "@type": "PostalAddress",
    addressLocality: "北京",
    addressCountry: "CN",
  },
};
const schema =
  page === "blog"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        image,
        author: person,
        datePublished: pubDate,
        dateModified: pubDate,
        mainEntityOfPage: Astro.url.href,
      }
    : { "@context": "https://schema.org", ...person };
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <Font cssVariable="--font-cabinet-grotesk" preload />
    <Font cssVariable="--font-satoshi" preload />
    <ClientRouter />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/identity-icon.svg" />
    <meta name="apple-mobile-web-app-title" content="李星辰" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta content={Astro.generator} name="generator" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <meta content="index, follow" name="robots" />
    <meta name="theme-color" content="#111111" />
    <meta name="author" content={SITE.author.fullName} />
    <meta
      name="keywords"
      content="李星辰,北京邮电大学,AI Agent,RAG,大模型安全,软件开发,Python,Java,LangGraph"
    />
    <meta
      content={page === "blog" ? "article" : "website"}
      property="og:type"
    />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={Astro.url.href} property="og:url" />
    <meta property="og:site_name" content="李星辰的个人主页" />
    <meta property="og:locale" content="zh_CN" />
    <meta content={image} property="og:image" />
    <meta property="og:image:alt" content="李星辰 · AI 与软件开发" />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={image} name="twitter:image" />
    <link href={Astro.url.href} rel="canonical" />
    <script
      is:inline
      set:html={JSON.stringify(schema)}
      type="application/ld+json"
    />
    {
      import.meta.env.UMAMI_WEBSITE_ID && (
        <script
          defer
          is:inline
          src="https://cloud.umami.is/script.js"
          data-website-id={import.meta.env.UMAMI_WEBSITE_ID}
          data-domains={SITE.site.domain}
        />
      )
    }
    {
      import.meta.env.AHREFS_ANALYTICS_KEY && (
        <script
          is:inline
          src="https://analytics.ahrefs.com/analytics.js"
          data-key={import.meta.env.AHREFS_ANALYTICS_KEY}
          async
        />
      )
    }
    <style is:inline set:html={`:root{${cssVars(BUTTON_FRAME)}}`}></style>
  </head>
  <body
    class="bg-darkslate-700 flex flex-col justify-center items-center yellow-theme style-neon"
  >
    <script is:inline set:html={appearanceBootstrap} />
    <GridTransition />
    <slot />
    <div
      class="fixed bottom-4 right-4 md:bottom-6 z-50 w-9 flex flex-col items-center gap-2"
    >
      <BackToTop />
      {
        !hideSoundToggle && (
          <>
            <StylePanel />
            <button
              id="sound-toggle"
              aria-label="关闭音效"
              title="关闭音效"
              aria-pressed="true"
              class="chrome--ns w-9 h-9 flex items-center justify-center rounded-lg bg-darkslate-500 border border-darkslate-400 hover:border-primary-500 transition-all duration-200 text-white shadow-lg"
            >
              <Icon id="sound-icon-on" name="pixel-sound-on" class="w-4 h-4" />
              <Icon
                id="sound-icon-off"
                name="pixel-sound-off"
                class="w-4 h-4 hidden"
              />
            </button>
          </>
        )
      }
    </div>
  </body>
</html>
<script>
  import { initScrollNavigation } from "../lib/scroll-navigation";
  import { initNineSliceFallback } from "../lib/nine-slice-fallback";
  import { CARD_HOVER, play } from "../lib/sound";
  import { applyAppearance } from "../lib/appearance";
  import {
    PORTFOLIO_HAS_VISITED_NON_HOME_KEY,
    PORTFOLIO_LAST_PATH_KEY,
    normalizePathname,
  } from "../lib/nav-path";
  let disposeNineSlice: (() => void) | null = null;
  let disposeScrollNavigation: (() => void) | null = null;
  let soundEnabled = true;
  const playCardHover = () => play(CARD_HOVER);
  function updateToggleIcon() {
    document
      .getElementById("sound-icon-on")
      ?.classList.toggle("hidden", !soundEnabled);
    document
      .getElementById("sound-icon-off")
      ?.classList.toggle("hidden", soundEnabled);
    const toggle = document.getElementById("sound-toggle");
    toggle?.setAttribute("aria-label", soundEnabled ? "关闭音效" : "开启音效");
    toggle?.setAttribute("title", soundEnabled ? "关闭音效" : "开启音效");
    toggle?.setAttribute("aria-pressed", String(soundEnabled));
  }
  document.addEventListener("astro:page-load", () => {
    applyAppearance();
    disposeScrollNavigation?.();
    disposeScrollNavigation = initScrollNavigation();
    try {
      soundEnabled = localStorage.getItem("soundEnabled") !== "false";
    } catch {
      soundEnabled = true;
    }
    updateToggleIcon();
    document.querySelectorAll<HTMLElement>(".card").forEach((card) => {
      card.removeEventListener("mouseenter", playCardHover);
      card.addEventListener("mouseenter", playCardHover);
    });
    document.getElementById("sound-toggle")?.addEventListener("click", () => {
      soundEnabled = !soundEnabled;
      try {
        localStorage.setItem("soundEnabled", String(soundEnabled));
      } catch {}
      updateToggleIcon();
    });
    disposeNineSlice?.();
    disposeNineSlice = initNineSliceFallback();
    try {
      const path = normalizePathname(window.location.pathname);
      if (path !== "/")
        sessionStorage.setItem(PORTFOLIO_HAS_VISITED_NON_HOME_KEY, "1");
      queueMicrotask(() =>
        sessionStorage.setItem(PORTFOLIO_LAST_PATH_KEY, path),
      );
    } catch {}
  });
  document.addEventListener("astro:before-swap", (event) => {
    disposeScrollNavigation?.();
    disposeScrollNavigation = null;
    const next = (event as unknown as { newDocument: Document }).newDocument;
    applyAppearance(next.body);
    disposeNineSlice?.();
    disposeNineSlice = null;
  });
</script>
<style is:global>
  body {
    margin: 0;
    min-height: 100dvh;
    font-family:
      var(--font-satoshi), "PingFang SC", "Microsoft YaHei", "Noto Sans SC",
      sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family:
      var(--font-cabinet-grotesk), "PingFang SC", "Microsoft YaHei", sans-serif;
  }
  p {
    font-family: inherit;
  }
  b {
    font-weight: 700 !important;
  }
  @supports (view-transition-name: none) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 320ms;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
  }
</style>
